# Devin API v3 credentials. Backend only; never commit real values.
# Personal Access Token from app.devin.ai -> Settings -> Devin API -> "PATs" tab (starts with cog_)
DEVIN_API_KEY=
# Organization ID shown at the top of Settings -> Devin API (starts with org-)
DEVIN_ORG_ID=
# Optional: Devin agent mode for parser sessions (e.g. lite, normal). Empty = organization default.
DEVIN_MODE=
# Optional: hard cap on ACUs a single parser session may consume.
DEVIN_MAX_ACU_LIMIT=
